# ==========================================
# EduMarket - Supabase Configuration
# ==========================================

# 1. Project URL from your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co

# 2. Public Anon Key from Supabase Dashboard -> Project Settings -> API
SUPABASE_ANON_KEY=your-anon-key-here

# 3. Optional: Service Role Key (if using server-side elevated access)
SUPABASE_SERVICE_ROLE_KEY=

# Server Port
PORT=3000

